# HMX Predictor — example environment (no credentials required)
# Copy to .env and export the variables in your shell or CI secrets.

# Public read-only sources (undocumented; replace with authorized feed in production)
HMX_KV_ISSUE_URL=https://maanwin29.com/webapi/kv/issue/WinGo_1M
HMX_SCHEDULE_URL=https://draw.ar-lottery01.com/WinGo/WinGo_1M.json
HMX_HISTORY_URL=https://draw.ar-lottery01.com/WinGo/WinGo_1M/GetHistoryIssuePage.json

# Politeness / behaviour
HMX_POLL_INTERVAL_SECONDS=60
HMX_REQUEST_TIMEOUT_SECONDS=15
HMX_MAX_RETRIES=4
HMX_PROVIDER_ENABLED=1
HMX_COLLECTOR_AUTOSTART=0

# Server
HMX_HOST=127.0.0.1
HMX_PORT=8765
HMX_RATE_LIMIT_PER_MINUTE=120

# Storage
HMX_DB_PATH=./data/hmx.sqlite3
HMX_DATA_DIR=./data
HMX_LOG_DIR=./logs

# Never set account credentials, cookies or tokens here. This app does not use them.
